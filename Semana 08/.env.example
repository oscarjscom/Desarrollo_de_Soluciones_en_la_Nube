# Copia este archivo como .env y completa los valores
PORT=3000
BASE_URL=http://localhost:3000
JWT_SECRET=cambia-este-secreto-largo-y-aleatorio

# Login con Google  (https://console.cloud.google.com -> APIs y servicios -> Credenciales)
# URI de redirección autorizada: http://localhost:3000/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Login con GitHub  (https://github.com/settings/developers -> New OAuth App)
# Authorization callback URL: http://localhost:3000/auth/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
