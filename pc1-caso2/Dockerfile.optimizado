# Usa imagen Alpine para menor tamaño
FROM python:3.11-alpine

# Establece directorio de trabajo
WORKDIR /app

# Copia e instala dependencias primero (mejor cache)
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# Copia el código de la aplicación
COPY app.py .

# Carpeta de datos y usuario no-root para seguridad
RUN mkdir -p /app/data \
    && adduser -D appuser && chown -R appuser /app
USER appuser

# Expone el puerto
EXPOSE 5001

# Health check
HEALTHCHECK --interval=30s --timeout=3s \
  CMD python -c "import urllib.request; urllib.request.urlopen('http://localhost:5001')" || exit 1

# Comando de ejecución
CMD ["python", "app.py"]
